<UserControl x:Class="AcDbPlugin.Views.EpdbPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AcDbPlugin.ViewModels"
             xmlns:v="clr-namespace:AcDbPlugin.Views"
             MinWidth="380" MinHeight="400">

    <UserControl.Resources>
        <v:BoolToVisibilityConverter  x:Key="BoolToVis"/>
        <v:NullToVisibilityConverter  x:Key="NullToVis"/>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Padding"     Value="8,3"/>
            <Setter Property="Margin"      Value="2,0"/>
            <Setter Property="MinWidth"    Value="60"/>
            <Setter Property="FontSize"    Value="11"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Margin"      Value="0,4,0,2"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"         Value="False"/>
            <Setter Property="CanUserAddRows"              Value="False"/>
            <Setter Property="CanUserDeleteRows"           Value="False"/>
            <Setter Property="IsReadOnly"                  Value="True"/>
            <Setter Property="GridLinesVisibility"         Value="Horizontal"/>
            <Setter Property="AlternatingRowBackground"    Value="#F5F8FC"/>
            <Setter Property="SelectionMode"               Value="Single"/>
            <Setter Property="FontSize"                    Value="11"/>
            <Setter Property="ColumnHeaderHeight"          Value="24"/>
            <Setter Property="RowHeight"                   Value="22"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar: DB path + project selector -->
            <RowDefinition Height="*"/>      <!-- Main tab content -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== TOP TOOLBAR ===== -->
        <Border Grid.Row="0" Background="#2B579A" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Project selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Project:" Foreground="White" VerticalAlignment="Center"
                               Margin="0,0,6,0" FontSize="11"/>
                    <ComboBox ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              DisplayMemberPath="ProjectNumber"
                              Width="140" FontSize="11"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Refresh"
                        Command="{Binding LoadProjectsCommand}"
                        Style="{StaticResource ToolBtn}"
                        ToolTip="Reload project list"/>

                <Button Grid.Column="2" Content="Set DB..."
                        Command="{Binding SetDatabaseCommand}"
                        Style="{StaticResource ToolBtn}"
                        ToolTip="Choose a different database file"/>
            </Grid>
        </Border>

        <!-- ===== TAB CONTROL ===== -->
        <TabControl Grid.Row="1" Margin="2">

            <!-- ── PROJECT ── -->
            <TabItem Header="Project">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Project toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="New Project" Command="{Binding AddProjectCommand}"
                                Style="{StaticResource ToolBtn}" FontWeight="SemiBold"/>
                        <Button Content="Edit"   Command="{Binding EditProjectCommand}"   Style="{StaticResource ToolBtn}"/>
                        <Button Content="Delete" Command="{Binding DeleteProjectCommand}" Style="{StaticResource ToolBtn}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel DataContext="{Binding SelectedProject}">
                        <TextBlock Text="No project selected."
                                   Visibility="{Binding Converter={StaticResource NullToVis}}"
                                   Foreground="Gray" Margin="0,20,0,0" HorizontalAlignment="Center"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Number:"      FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProjectNumber}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:"        FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProjectName}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Client:"      FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Client}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Location:"    FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Location}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Engineer:"    FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EngineerOfRecord}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="NEC Edition:" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding NecEdition}"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Voltage Sys:" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding VoltageSystem}"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Issue Date:"  FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="7" Grid.Column="1"
                                       Text="{Binding IssueDate, StringFormat='yyyy-MM-dd'}"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Notes:"       FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Notes}" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── CATALOGS ── -->
            <TabItem Header="Catalogs">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Table:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Catalogs.CatalogTables}"
                                  SelectedItem="{Binding Catalogs.SelectedTable}"
                                  Width="160"/>
                        <Button Content="Refresh"
                                Command="{Binding Catalogs.RefreshCommand}"
                                Style="{StaticResource ToolBtn}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Auto-generated columns from DataTable -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Catalogs.Rows}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              FontSize="11"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F5F8FC"
                              RowHeight="22"/>
                </Grid>
            </TabItem>

            <!-- ── EQUIPMENT ── -->
            <TabItem Header="Equipment">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- primary toolbar -->
                        <RowDefinition Height="Auto"/>  <!-- link toolbar -->
                        <RowDefinition Height="Auto"/>  <!-- poller strip -->
                        <RowDefinition Height="*"/>     <!-- datagrid -->
                    </Grid.RowDefinitions>

                    <!-- Primary toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Content="Add"    Command="{Binding Equipment.AddCommand}"    Style="{StaticResource ToolBtn}"/>
                        <Button Content="Edit"   Command="{Binding Equipment.EditCommand}"   Style="{StaticResource ToolBtn}"/>
                        <Button Content="Delete" Command="{Binding Equipment.DeleteCommand}" Style="{StaticResource ToolBtn}"/>
                        <Separator Width="1" Margin="4,0"/>
                        <Button Content="Insert -&gt; Drawing"
                                Command="{Binding Equipment.InsertDrawingCommand}"
                                Style="{StaticResource ToolBtn}"
                                Background="#E8F0FE"/>
                        <Button Content="Refresh"
                                Command="{Binding Equipment.RefreshCommand}"
                                Style="{StaticResource ToolBtn}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Link toolbar (requires a selected equipment row) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Content="Link to Block"
                                Command="{Binding Equipment.LinkObjectCommand}"
                                Style="{StaticResource ToolBtn}"
                                Background="#FFF3CD"
                                ToolTip="Select equipment row, then click to pick an AutoCAD object and link it to this record (stores equip_id in XData)."/>
                        <Button Content="Sync Linked Blocks"
                                Command="{Binding SyncLinkedCommand}"
                                Style="{StaticResource ToolBtn}"
                                Background="#D4EDDA"
                                ToolTip="Re-read the database and refresh all linked block attributes in model space."/>
                    </StackPanel>

                    <!-- Poller strip: auto-sync when DB file changes -->
                    <Border Grid.Row="2" Background="#F0F0F0" Padding="4,2" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding PollerEnabled}"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      ToolTip="Automatically sync linked blocks when the database file is modified on disk. This uses polling — not a live push."/>
                            <TextBlock Text="Auto-sync every" FontSize="10" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PollerIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Width="32" Margin="4,0" FontSize="10" Padding="2,1"
                                     ToolTip="Polling interval in seconds (minimum 1)"/>
                            <TextBlock Text="s" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding Equipment.Rows}"
                              SelectedItem="{Binding Equipment.Selected, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag"           Binding="{Binding Tag}"          Width="70"/>
                            <DataGridTextColumn Header="Name"          Binding="{Binding Name}"         Width="*"/>
                            <DataGridTextColumn Header="V"             Binding="{Binding BusVoltageV}"  Width="45"/>
                            <DataGridTextColumn Header="Fed From"      Binding="{Binding FedFromTag}"   Width="70"/>
                            <DataGridTextColumn Header="Trip (A)"      Binding="{Binding BreakerTripA}" Width="55"/>
                            <DataGridTextColumn Header="Drawing"       Binding="{Binding DrawingRef}"   Width="70"/>
                            <DataGridTextColumn Header="Sheet"         Binding="{Binding SheetNumber}"  Width="50"/>
                            <DataGridTextColumn Header="Status"        Binding="{Binding Status}"       Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ── INSTRUMENTS ── -->
            <TabItem Header="Instruments">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Add"    Command="{Binding Instruments.AddCommand}"    Style="{StaticResource ToolBtn}"/>
                        <Button Content="Edit"   Command="{Binding Instruments.EditCommand}"   Style="{StaticResource ToolBtn}"/>
                        <Button Content="Delete" Command="{Binding Instruments.DeleteCommand}" Style="{StaticResource ToolBtn}"/>
                        <Separator Width="1" Margin="4,0"/>
                        <Button Content="Insert -&gt; Drawing"
                                Command="{Binding Instruments.InsertDrawingCommand}"
                                Style="{StaticResource ToolBtn}"
                                Background="#E8F0FE"/>
                        <Button Content="Refresh"
                                Command="{Binding Instruments.RefreshCommand}"
                                Style="{StaticResource ToolBtn}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Instruments.Rows}"
                              SelectedItem="{Binding Instruments.Selected, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag"        Binding="{Binding Tag}"               Width="80"/>
                            <DataGridTextColumn Header="Service"    Binding="{Binding ServiceDescription}" Width="*"/>
                            <DataGridTextColumn Header="Signal"     Binding="{Binding SignalType}"         Width="65"/>
                            <DataGridTextColumn Header="Loop #"     Binding="{Binding LoopNumber}"         Width="55"/>
                            <DataGridTextColumn Header="P&amp;ID"   Binding="{Binding PAndIdRef}"          Width="65"/>
                            <DataGridTextColumn Header="Sheet"      Binding="{Binding SheetNumber}"        Width="50"/>
                            <DataGridTextColumn Header="Status"     Binding="{Binding Status}"             Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ── CABLES ── -->
            <TabItem Header="Cables">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Add"    Command="{Binding Cables.AddCommand}"    Style="{StaticResource ToolBtn}"/>
                        <Button Content="Edit"   Command="{Binding Cables.EditCommand}"   Style="{StaticResource ToolBtn}"/>
                        <Button Content="Delete" Command="{Binding Cables.DeleteCommand}" Style="{StaticResource ToolBtn}"/>
                        <Separator Width="1" Margin="4,0"/>
                        <Button Content="Insert -&gt; Drawing"
                                Command="{Binding Cables.InsertDrawingCommand}"
                                Style="{StaticResource ToolBtn}"
                                Background="#E8F0FE"/>
                        <Button Content="Refresh"
                                Command="{Binding Cables.RefreshCommand}"
                                Style="{StaticResource ToolBtn}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Cables.Rows}"
                              SelectedItem="{Binding Cables.Selected, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cable Tag"  Binding="{Binding CableTag}"          Width="75"/>
                            <DataGridTextColumn Header="Service"    Binding="{Binding ServiceDescription}" Width="*"/>
                            <DataGridTextColumn Header="FROM"       Binding="{Binding FromTag}"           Width="65"/>
                            <DataGridTextColumn Header="F.Term"     Binding="{Binding FromTerminal}"      Width="45"/>
                            <DataGridTextColumn Header="TO"         Binding="{Binding ToTag}"             Width="65"/>
                            <DataGridTextColumn Header="T.Term"     Binding="{Binding ToTerminal}"        Width="45"/>
                            <DataGridTextColumn Header="Len (ft)"   Binding="{Binding LengthFt}"          Width="55"/>
                            <DataGridTextColumn Header="Status"     Binding="{Binding Status}"            Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Grid Margin="6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Status}"
                           FontSize="10" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="60" Height="10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
