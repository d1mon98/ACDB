<Window x:Class="AcDbPlugin.Views.ProjectEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AcDbPlugin.Views"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Width"             Value="130"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Foreground"        Value="#333"/>
        </Style>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Margin"  Value="0,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,8,0,2"/>
            <Setter Property="Foreground" Value="#2B579A"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2B579A" Padding="10,6">
            <TextBlock Text="{Binding Title}" Foreground="White"
                       FontWeight="SemiBold" FontSize="13"/>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#CCC" BorderThickness="0,1,0,0"
                Padding="10,6" Background="#F8F8F8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK"     Width="80" Margin="0,0,6,0"
                        Click="OkButton_Click" IsDefault="True"/>
                <Button Content="Cancel" Width="80"
                        Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,8">

                <TextBlock Style="{StaticResource Sec}" Text="Identification"/>

                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Lbl}" Text="Project Number *"/>
                    <TextBox   Style="{StaticResource Fld}" Width="240"
                               Text="{Binding ProjectNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Lbl}" Text="Project Name"/>
                    <TextBox   Style="{StaticResource Fld}" Width="240"
                               Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Lbl}" Text="Client"/>
                    <TextBox   Style="{StaticResource Fld}" Width="240"
                               Text="{Binding Client}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Lbl}" Text="Location"/>
                    <TextBox   Style="{StaticResource Fld}" Width="240"
                               Text="{Binding Location}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Lbl}" Text="Engineer of Record"/>
                    <TextBox   Style="{StaticResource Fld}" Width="240"
                               Text="{Binding Engineer}"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Sec}" Text="Electrical System"/>

                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Lbl}" Text="NEC Edition"/>
                    <ComboBox  Margin="0,3" FontSize="11" Width="100"
                               ItemsSource="{Binding NecEditions}"
                               SelectedItem="{Binding NecEdition}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Lbl}" Text="Voltage System"/>
                    <TextBox   Style="{StaticResource Fld}" Width="180"
                               Text="{Binding VoltageSystem}"
                               ToolTip="e.g. 480/277V 3Ph 4W, 208/120V 3Ph 4W"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Lbl}" Text="Issue Date"/>
                    <TextBox   Style="{StaticResource Fld}" Width="120"
                               Text="{Binding IssueDate}"
                               ToolTip="yyyy-MM-dd"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Sec}" Text="Notes"/>
                <TextBox Text="{Binding Notes}" Height="60" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontSize="11" Padding="3" Margin="0,2"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
