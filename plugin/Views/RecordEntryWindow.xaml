<Window x:Class="AcDbPlugin.Views.RecordEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AcDbPlugin.Views"
        Title="{Binding Title}"
        Width="480" SizeToContent="Height"
        MinHeight="300" MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Width"           Value="130"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="#333"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Margin"          Value="0,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="3,2"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Margin"          Value="0,2"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Margin"          Value="0,8,0,2"/>
            <Setter Property="Foreground"      Value="#2B579A"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Title bar ===== -->
        <Border DockPanel.Dock="Top" Background="#2B579A" Padding="10,6">
            <TextBlock Text="{Binding Title}" Foreground="White"
                       FontWeight="SemiBold" FontSize="13"/>
        </Border>

        <!-- ===== OK / Cancel ===== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCC" BorderThickness="0,1,0,0"
                Padding="10,6" Background="#F8F8F8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK"     Width="80" Margin="0,0,6,0"
                        Click="OkButton_Click" IsDefault="True"/>
                <Button Content="Cancel" Width="80"
                        Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- ===== Scrollable form ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,8">

                <!-- ── Catalog Picker ── -->
                <TextBlock Style="{StaticResource Section}" Text="Catalog Source (optional — pre-fills fields)"/>

                <!-- Equipment catalog -->
                <StackPanel Orientation="Horizontal" Margin="0,2"
                            Visibility="{Binding IsEquipment, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Label}" Text="Equipment Catalog:"/>
                    <ComboBox Style="{StaticResource FieldCombo}"
                              Width="310"
                              ItemsSource="{Binding EquipCatalogs}"
                              SelectedItem="{Binding SelectedEquipCatalog}"
                              DisplayMemberPath="Description"/>
                </StackPanel>

                <!-- Instrument catalog -->
                <StackPanel Orientation="Horizontal" Margin="0,2"
                            Visibility="{Binding IsInstrument, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Label}" Text="Instrument Catalog:"/>
                    <ComboBox Style="{StaticResource FieldCombo}"
                              Width="310"
                              ItemsSource="{Binding InstrumentCatalogs}"
                              SelectedItem="{Binding SelectedInstrumentCatalog}"
                              DisplayMemberPath="Description"/>
                </StackPanel>

                <!-- Cable catalog -->
                <StackPanel Orientation="Horizontal" Margin="0,2"
                            Visibility="{Binding IsCable, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Label}" Text="Cable Catalog:"/>
                    <ComboBox Style="{StaticResource FieldCombo}"
                              Width="310"
                              ItemsSource="{Binding CableCatalogs}"
                              SelectedItem="{Binding SelectedCableCatalog}"
                              DisplayMemberPath="TradeName"/>
                </StackPanel>

                <Separator Margin="0,6"/>

                <!-- ── Shared Fields ── -->
                <TextBlock Style="{StaticResource Section}" Text="Identification"/>

                <StackPanel Orientation="Horizontal" Margin="0,2"
                            Visibility="{Binding IsCable, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Style="{StaticResource Label}" Text="Tag *"/>
                    <TextBox   Style="{StaticResource Field}" Width="200"
                               Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2"
                            Visibility="{Binding IsCable, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Label}" Text="Cable Tag *"/>
                    <TextBox   Style="{StaticResource Field}" Width="200"
                               Text="{Binding CableTag, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- ── Equipment-only Fields ── -->
                <StackPanel Visibility="{Binding IsEquipment, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Section}" Text="Equipment Details"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Name / Description"/>
                        <TextBox   Style="{StaticResource Field}" Width="310"
                                   Text="{Binding Name}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Bus Voltage (V)"/>
                        <TextBox   Style="{StaticResource Field}" Width="100"
                                   Text="{Binding BusVoltageV}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Fed From Tag"/>
                        <TextBox   Style="{StaticResource Field}" Width="150"
                                   Text="{Binding FedFromTag}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Breaker Trip (A)"/>
                        <TextBox   Style="{StaticResource Field}" Width="100"
                                   Text="{Binding BreakerTripA}"/>
                        <TextBlock Text="Frame (A):" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox   Style="{StaticResource Field}" Width="80"
                                   Text="{Binding BreakerFrameA}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="One-Line Ref"/>
                        <TextBox   Style="{StaticResource Field}" Width="200"
                                   Text="{Binding OneLineRef}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Instrument-only Fields ── -->
                <StackPanel Visibility="{Binding IsInstrument, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Section}" Text="Instrument Details"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Service Description"/>
                        <TextBox   Style="{StaticResource Field}" Width="310"
                                   Text="{Binding ServiceDescription}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Loop Number"/>
                        <TextBox   Style="{StaticResource Field}" Width="120"
                                   Text="{Binding LoopNumber}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="P&amp;ID Reference"/>
                        <TextBox   Style="{StaticResource Field}" Width="200"
                                   Text="{Binding PAndIdRef}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Panel Tag"/>
                        <TextBox   Style="{StaticResource Field}" Width="150"
                                   Text="{Binding PanelTag}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Signal Type"/>
                        <TextBox   Style="{StaticResource Field}" Width="150"
                                   Text="{Binding SignalType}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Supply Source Tag"/>
                        <TextBox   Style="{StaticResource Field}" Width="150"
                                   Text="{Binding SupplySourceTag}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Cable-only Fields ── -->
                <StackPanel Visibility="{Binding IsCable, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Section}" Text="FROM Endpoint"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="FROM Tag *"/>
                        <TextBox   Style="{StaticResource Field}" Width="160"
                                   Text="{Binding FromTag}"/>
                        <TextBlock Text="Terminal:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox   Style="{StaticResource Field}" Width="80"
                                   Text="{Binding FromTerminal}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="TO Endpoint"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="TO Tag *"/>
                        <TextBox   Style="{StaticResource Field}" Width="160"
                                   Text="{Binding ToTag}"/>
                        <TextBlock Text="Terminal:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox   Style="{StaticResource Field}" Width="80"
                                   Text="{Binding ToTerminal}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="Cable Details"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Service Description"/>
                        <TextBox   Style="{StaticResource Field}" Width="310"
                                   Text="{Binding ServiceDescription}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Conduit Tag"/>
                        <TextBox   Style="{StaticResource Field}" Width="120"
                                   Text="{Binding ConduitTag}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Length (ft)"/>
                        <TextBox   Style="{StaticResource Field}" Width="100"
                                   Text="{Binding LengthFt}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Conductor Size"/>
                        <TextBox   Style="{StaticResource Field}" Width="120"
                                   Text="{Binding ConductorSize}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Shared: Drawing / Status ── -->
                <TextBlock Style="{StaticResource Section}" Text="Drawing Reference &amp; Status"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Label}" Text="Drawing Ref"/>
                    <TextBox   Style="{StaticResource Field}" Width="160"
                               Text="{Binding DrawingRef}"/>
                    <TextBlock Text="Sheet:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox   Style="{StaticResource Field}" Width="80"
                               Text="{Binding SheetNumber}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource Label}" Text="Status"/>
                    <ComboBox  Style="{StaticResource FieldCombo}" Width="140"
                               ItemsSource="{Binding StatusOptions}"
                               SelectedItem="{Binding Status}"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="Notes"/>
                <TextBox Text="{Binding Notes}" Height="60" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontSize="11" Padding="3" Margin="0,2"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
